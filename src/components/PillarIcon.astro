---
import type { Pillar } from "../config/services";

interface Props {
  icon: Pillar["icon"];
}

const { icon } = Astro.props;
---

<div
  class="flex size-11 items-center justify-center rounded-xl bg-canary-400/15 text-canary-600 dark:text-canary-400"
>
  {
    icon === "code" && (
      <svg viewBox="0 0 24 24" fill="none" strokeWidth={1.75} class="size-6 stroke-current">
        <path d="M9 8l-4 4 4 4M15 8l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    icon === "cloud" && (
      <svg viewBox="0 0 24 24" fill="none" strokeWidth={1.75} class="size-6 stroke-current">
        <path
          d="M7 18a4 4 0 01-.5-7.97A5.5 5.5 0 0117.9 9.2 3.75 3.75 0 0117 18H7z"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {
    icon === "spark" && (
      <svg viewBox="0 0 24 24" fill="none" strokeWidth={1.75} class="size-6 stroke-current">
        <path
          d="M12 3l1.8 5L19 9.8l-5.2 1.9L12 17l-1.8-5.3L5 9.8l5.2-1.8L12 3z"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M18.5 15.5l.7 1.9 1.8.6-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.6.7-1.9z"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {
    icon === "layers" && (
      <svg viewBox="0 0 24 24" fill="none" strokeWidth={1.75} class="size-6 stroke-current">
        <path d="M12 3l9 5-9 5-9-5 9-5z" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M3 12l9 5 9-5M3 16l9 5 9-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</div>
