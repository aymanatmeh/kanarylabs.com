---
import Layout from "./Layout.astro";
import DocsHeader from "../components/docs/DocsHeader.astro";
import DocsSidebar from "../components/docs/DocsSidebar.tsx";
import type { PackageDocs, RenderedPage } from "../lib/docs";

interface Props {
  docs: PackageDocs;
  current: RenderedPage;
}

const { docs, current } = Astro.props;
const { pkg, tree, baseUrl } = docs;

const href = (slug: string) => `${baseUrl}/${slug}`;
const toLink = (p: { slug: string; title: string }) => ({
  slug: p.slug,
  title: p.title,
  href: href(p.slug),
});

const rootLinks = tree.rootPages.filter((p) => !p.hidden).map(toLink);
const groups = tree.groups.map((group) => ({
  id: group.id,
  title: group.title,
  links: group.pages.filter((p) => !p.hidden).map(toLink),
}));

const { page, headings, prev, next } = current;
const title = `${page.title} — ${pkg.name} docs | KanaryLabs`;
---

<Layout title={title} description={docs.tree.meta.slogan ?? pkg.description}>
  <DocsHeader />

  <div class="mx-auto flex max-w-8xl flex-col gap-x-12 px-6 lg:flex-row lg:px-8">
    <aside
      class="lg:sticky lg:top-16 lg:h-[calc(100dvh-4rem)] lg:w-64 lg:shrink-0 lg:overflow-y-auto lg:py-12"
    >
      <DocsSidebar
        client:load
        packageName={pkg.name}
        packageHref={baseUrl}
        rootLinks={rootLinks}
        groups={groups}
        currentSlug={page.slug}
        versions={pkg.versions}
        versionLabel={docs.versionLabel}
      />
    </aside>

    <div class="flex min-w-0 flex-1 gap-x-12 py-10 sm:py-12">
      <article class="min-w-0 flex-1" data-pagefind-body>
        {/* Metadata shown alongside search results. */}
        <span hidden data-pagefind-meta="package">{pkg.name}</span>
        <span hidden data-pagefind-meta="section">
          {tree.groups.find((g) => g.id === page.group)?.title ?? "Overview"}
        </span>
        <header>
          <p class="font-mono text-sm font-medium tracking-wide text-canary-600 uppercase dark:text-canary-400">
            {tree.groups.find((g) => g.id === page.group)?.title ?? pkg.name}
          </p>
          <h1 class="mt-3 max-w-[35ch] text-4xl font-semibold tracking-tight text-balance text-neutral-900 dark:text-white">
            {page.title}
          </h1>
        </header>

        <div class="prose mt-10 max-w-[75ch]" set:html={current.html} />

        <nav
          class="mt-16 flex flex-col gap-4 border-t border-neutral-950/5 pt-8 sm:flex-row sm:justify-between dark:border-white/10"
          aria-label="Pagination"
        >
          {
            prev ? (
              <a
                href={href(prev.slug)}
                class="group flex flex-col gap-y-1 text-base text-neutral-600 dark:text-neutral-400"
              >
                <span class="text-sm">Previous</span>
                <span class="font-semibold text-neutral-900 dark:text-white">← {prev.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a
                href={href(next.slug)}
                class="group flex flex-col gap-y-1 text-base text-neutral-600 sm:items-end sm:text-right dark:text-neutral-400"
              >
                <span class="text-sm">Next</span>
                <span class="font-semibold text-neutral-900 dark:text-white">{next.title} →</span>
              </a>
            )
          }
        </nav>

        <p class="mt-10 text-sm text-neutral-500 dark:text-neutral-500">
          <a
            href={`https://github.com/${pkg.repo}/edit/${docs.ref}/${pkg.docsDir}/${page.sourcePath}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-neutral-900 dark:hover:text-white"
          >
            Edit this page on GitHub
          </a>
        </p>
      </article>

      {
        headings.length > 1 && (
          <nav
            aria-label="On this page"
            class="sticky top-28 hidden h-fit w-56 shrink-0 xl:block"
          >
            <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">On this page</h2>
            <ul role="list" class="mt-3 flex flex-col gap-y-2">
              {headings.map((heading) => (
                <li class={heading.depth > 2 ? "pl-4" : undefined}>
                  <a
                    href={`#${heading.slug}`}
                    class="text-base text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</Layout>

<script>
  // Add a copy button to every code block. Done here rather than in the
  // markdown pipeline so the rendered HTML stays plain and cacheable.
  const COPY = "Copy";
  for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
    const wrapper = document.createElement("div");
    wrapper.className = "relative group/code";
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const button = document.createElement("button");
    button.type = "button";
    button.textContent = COPY;
    button.className =
      "absolute top-3 right-3 rounded-lg bg-white/10 px-2 py-1 text-xs font-medium text-white opacity-0 backdrop-blur-sm group-hover/code:opacity-100 focus-visible:opacity-100";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        button.textContent = "Copied!";
        setTimeout(() => (button.textContent = COPY), 1600);
      } catch {
        /* clipboard unavailable */
      }
    });
    wrapper.appendChild(button);
  }
</script>
